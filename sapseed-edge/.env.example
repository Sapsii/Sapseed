# Optional live Sapsii upload settings. Live inference still works when blank.
SAPSEED_API_URL=http://192.168.1.10:3001
SAPSEED_DEVICE_AUTHORIZATION=Device <credential-id>.<secret>

# The edge app reports itself to the platform as DEVICE_NAME-IMEI_HASH{6}.
# DEVICE_NAME is read from Settings -> About phone on the device at runtime, so
# nothing has to be configured per unit here.
